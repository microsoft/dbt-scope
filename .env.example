# dbt-scope environment configuration
# Copy to .env and fill in your values: cp .env.example .env
#
# These values are read by .scripts/run.ps1 and the test dbt project.
# NEVER commit the .env file — it contains sensitive infrastructure details.

SCOPE_ADLA_ACCOUNT=your-adla-account
SCOPE_STORAGE_ACCOUNT=your-storage-account
SCOPE_CONTAINER=your-container
SCOPE_DELTA_BASE_PATH=delta
SCOPE_SS_TEST_ROOT=/local/your-alias/ss
SCOPE_AU=100
SCOPE_PRIORITY=1
